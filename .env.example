NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor (cron de SMS y siembra). NUNCA con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Contraseña inicial del equipo de demo (scripts/seed.mjs).
# Solo se aplica a usuarios NUEVOS. No la pongas en Vercel.
DEMO_PASSWORD=

# URL pública de la app (reset de contraseña si no hay Origin).
# En Vercel suele bastar VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=https://marlenne-app-three.vercel.app

# Twilio para los recordatorios (si faltan, el cron no envía).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+34...
CRON_SECRET=
