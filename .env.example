NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor (siembra y, más adelante, SMS). NUNCA con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Contraseña inicial del equipo de demo (scripts/seed.mjs).
# Solo se aplica a usuarios NUEVOS. No la pongas en Vercel.
DEMO_PASSWORD=

# URL pública de la app (reset de contraseña si no hay Origin).
# En Vercel suele bastar VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=https://marlenne-app-three.vercel.app

# Voz con modelo (el micro habla normal) y voz más natural al preguntar.
# Sin esto, solo frases plantilla y la voz del Safari.
# MP3 fijos: npm run voice:clips (Elvira, sin clave).
# Para nova: OPENAI_API_KEY y npm run voice:clips:openai
OPENAI_API_KEY=

# SMS más adelante (Labs Mobile). El stub actual habla con Twilio y no
# envía nada si están vacías. No hace falta rellenarlas.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+34...
# CRON_SECRET=
