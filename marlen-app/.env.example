NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor (siembra y, más adelante, SMS). NUNCA con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Contraseña inicial del equipo de demo (scripts/seed.mjs).
# Solo se aplica a usuarios NUEVOS. No la pongas en Vercel.
DEMO_PASSWORD=

# URL pública de la app (reset de contraseña si no hay Origin).
# En Vercel suele bastar VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=https://marlenne-app.vercel.app

# Panel SaaS (proyecto Vercel aparte, root panel-saas). /platform/* → redirect externo.
NEXT_PUBLIC_PANEL_URL=http://localhost:3001

# LLM solo si el parser no pilla el comando. Sin clave, clips + diccionario.
OPENAI_API_KEY=
# Apagar nube sin deploy: VOICE_CLOUD=0 (TTS Elvira en vivo) VOICE_LLM=0
# VOICE_CLOUD=0
# VOICE_LLM=0

# Dictado por grabación (iPhone). Sin clave o con VOICE_STT=0 el servidor
# responde 503 y el cliente cae al dictado web en el siguiente turno.
GROQ_API_KEY=
# auto | web | record — forzar motor en pruebas
NEXT_PUBLIC_VOICE_STT=auto
# Apagar transcripción sin deploy: VOICE_STT=0
# VOICE_STT=0
# Forzar transcripción sin vocabulario (prueba A/B del prompt):
# VOICE_STT_PROMPT=0

# Cron Vercel (/api/cron/sms cada 30 min) y webhooks internos.
CRON_SECRET=

# Recordatorios SMS vía LabsMobile (multi-centro; remitente por salon en sms_config).
LABSMOBILE_USERNAME=
LABSMOBILE_API_TOKEN=
# Remitente por defecto si el centro no tiene sender en sms_config.
# LABSMOBILE_SENDER=Marlen
# ACK de entrega → /api/webhooks/labsmobile
LABSMOBILE_WEBHOOK_SECRET=
# LABSMOBILE_ACK_URL=https://tu-dominio/api/webhooks/labsmobile?secret=LABSMOBILE_WEBHOOK_SECRET
# Blindar preview/local: no factura SMS aunque test_mode esté off en BD.
# LABSMOBILE_TEST_MODE=1
